# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
datastar_ex-*.tar
# https://mise.jdx.dev/configuration.html
# https://mise.jdx.dev/configuration/environments.html
.mise.*.local.toml
.mise.local.toml
mise.*.local.toml
mise.local.toml
.mise/*.local.toml
mise/*.local.toml

# MacOS General
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
Icon[]

# Excel temporary files
~*.xls*
.~*.xls*

.superpowers/
.claude/
CLAUDE.md

# If you run "mix test --cover", coverage assets end up here.
/cover/
.six/coverage.md

# Local-only AI process docs (specs, plans, discussion) — not published
/docs/superpowers/
/docs/discussion/

# jj workspaces used for implementation
/.workspaces/

# Dialyzer PLTs (cached in CI, see .github/workflows/ci.yml)
/priv/plts/

# Cached clone of the official Datastar SDK conformance suite
/.conformance/
