#!/usr/bin/env bash
#MISE description="Run the pinned official Datastar SDK conformance suite (v1.0.4) against the local server"
set -euo pipefail

TAG="v1.0.4"
PORT="${PORT:-7331}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE="$ROOT/.conformance"
UPSTREAM="$CACHE/datastar-$TAG"
SERVER_LOG="$CACHE/server.log"

command -v go >/dev/null 2>&1 || { echo "error: the go toolchain is required on PATH" >&2; exit 1; }

mkdir -p "$CACHE"

if [ ! -d "$UPSTREAM" ]; then
  git clone --depth 1 --branch "$TAG" \
    https://github.com/starfederation/datastar.git "$UPSTREAM"
fi

cd "$ROOT"
MIX_ENV=test mix compile --warnings-as-errors

MIX_ENV=test mix run --no-halt -e "Datastar.Conformance.Server.run(${PORT})" \
  >"$SERVER_LOG" 2>&1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true' EXIT

ready=""
for _ in $(seq 1 100); do
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "error: conformance server exited unexpectedly; log follows" >&2
    cat "$SERVER_LOG" >&2
    exit 1
  fi
  if [ "$(curl -fs --max-time 2 "http://127.0.0.1:${PORT}/healthz" 2>/dev/null)" = "ok" ]; then
    ready=1
    break
  fi
  sleep 0.2
done

if [ -z "$ready" ]; then
  echo "error: conformance server not ready within 20s; log follows" >&2
  cat "$SERVER_LOG" >&2
  exit 1
fi

if ! (cd "$UPSTREAM/sdk/tests" && go run ./cmd/datastar-sdk-tests -server "http://127.0.0.1:${PORT}" -v); then
  echo "--- conformance server log ---" >&2
  cat "$SERVER_LOG" >&2
  exit 1
fi

echo "official Datastar ${TAG} conformance suite passed"
