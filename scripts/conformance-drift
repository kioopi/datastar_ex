#!/usr/bin/env bash
#MISE description="NON-BLOCKING: run the moving upstream (develop) suite to spot upcoming drift. Exit 0 none, 1 drift, 2 infra error"
set -euo pipefail

PORT="${PORT:-7331}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE="$ROOT/.conformance"
UPSTREAM="$CACHE/datastar-develop"
SERVER_LOG="$CACHE/drift-server.log"
RUNNER_LOG="$CACHE/drift-runner.log"

command -v go >/dev/null 2>&1 || { echo "error: go required" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "error: curl required" >&2; exit 2; }

mkdir -p "$CACHE"
if [ -d "$UPSTREAM/.git" ]; then
  git -C "$UPSTREAM" fetch --depth 1 origin develop
  git -C "$UPSTREAM" reset --hard origin/develop
else
  git clone --depth 1 --branch develop https://github.com/starfederation/datastar.git "$UPSTREAM"
fi
DRIFT_COMMIT=$(git -C "$UPSTREAM" rev-parse --short HEAD)

RUNNER_DIR="$UPSTREAM/sdk/tests"
[ -d "$RUNNER_DIR/cmd/datastar-sdk-tests" ] || {
  echo "error: upstream develop no longer contains sdk/tests/cmd/datastar-sdk-tests — the suite moved or was removed; adapt this script" >&2
  exit 2
}

cd "$ROOT"
MIX_ENV=test mix compile --warnings-as-errors

MIX_ENV=test mix run --no-halt -e "Datastar.Conformance.Server.run(${PORT})" >"$SERVER_LOG" 2>&1 &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true' EXIT INT TERM

ready=""
for _ in $(seq 1 100); do
  kill -0 "$SERVER_PID" 2>/dev/null || { echo "error: server exited; log:" >&2; cat "$SERVER_LOG" >&2; exit 2; }
  [ "$(curl -fs --max-time 2 "http://127.0.0.1:${PORT}/healthz" 2>/dev/null)" = "ok" ] && { ready=1; break; }
  sleep 0.2
done
[ -n "$ready" ] || { echo "error: server not ready; log:" >&2; cat "$SERVER_LOG" >&2; exit 2; }

set +e
(cd "$RUNNER_DIR" && go run ./cmd/datastar-sdk-tests -server "http://127.0.0.1:${PORT}" -v) 2>&1 | tee "$RUNNER_LOG"
runner_status=${PIPESTATUS[0]}
set -e

echo
if [ "$runner_status" -eq 0 ]; then
  echo "no drift: upstream develop ($DRIFT_COMMIT) suite passes against this SDK"
  exit 0
fi

echo "DRIFT DETECTED against upstream develop ($DRIFT_COMMIT) — this is informational, not a release gate." >&2
echo "Runner log: $RUNNER_LOG — follow the spec's §18.2 drift procedure before adopting upstream changes." >&2
exit 1
